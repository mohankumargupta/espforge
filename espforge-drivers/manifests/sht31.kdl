driver "sht31" {
    format_version 2
    summary "Sensirion SHT30/SHT31/SHT35 temperature and humidity sensor"
    description "Reads temperature and relative humidity over an I2C bus. Manifest only: the Rust type and constructor come straight from the `embedded-sht3x` crate, so `espforge-drivers` has no module and no feature for it. Built at boot."
    category "sensor"

    dependency "embedded-sht3x" { version "0.2.0" }

    bus "i2c" {
        address allowed="0x44..=0x45"
    }

    codegen {
        map "delay" {
            "runtime" { expr "espforge_runtime::Delay::new()" }
        }
        runtime "blocking" {
            type "embedded_sht3x::Sht3x<espforge_runtime::embedded_hal_bus::i2c::CriticalSectionDevice<'static, esp_hal::i2c::master::I2c<'static, esp_hal::Blocking>>, espforge_runtime::Delay>"
            constructor "embedded_sht3x::Sht3x::new({bus_device}, {address}, {delay})"
        }
    }

    attr "delay" kind="choice" default="runtime" {
        choices "runtime"
        help "The delay handle the driver takes; espforge always passes the runtime's own."
    }
    example "minimal" #"<sht31 id="air" bus="$i2c0" address="0x44" />"#
    example "alternate address" #"<sht31 id="air" bus="$i2c0" address="0x45" />"#
    see_also "peripherals/i2c"
}
