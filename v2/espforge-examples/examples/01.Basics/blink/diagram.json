{
  "version": 1,
  "author": "espforge",
  "editor": "wokwi",
  "refs": {
    "led_pin_number": "$red_led.pin",
    "gnd": "GND.10"
  },
  "parts": [
    { "type": "$board", "id": "esp", "top": 0, "left": 0 },
    { "type": "wokwi-led", "id": "led1", "top": -40, "left": 96, "attrs": { "color": "red", "gpio": "$led_pin_number" } }
  ],
  "connections": [
    [ "led1:A", "esp:$led_pin_number", "green", [] ],
    [ "led1:C", "esp:$gnd", "black", [] ]
  ]
}
