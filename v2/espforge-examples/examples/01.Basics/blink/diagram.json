{
  "version": 1,
  "author": "espforge",
  "editor": "wokwi",
  "refs": {
    "led_pin": "$red_led.pin",
    "gnd": "board:GND.2"
  },
  "parts": [
    { "type": "$board", "id": "board", "top": 0, "left": 0 },
    { "type": "wokwi-led", "id": "led1", "top": -40, "left": 96, "attrs": { "color": "red", "gpio": "$led_pin" } }
  ],
  "connections": [
    [ "led1:Anode", "board:$led_pin", "green", [] ],
    [ "led1:Cathode", "$gnd", "black", [] ]
  ]
}
