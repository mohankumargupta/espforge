[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"
{% if project.description %}
description = {{ project.description | tojson }}
{% endif %}

[[bin]]
name = "{{ project_name }}"
path = "./src/bin/main.rs"

[dependencies]
espforge-runtime = {{ runtime_dep }}
static_cell = "2.1.1"
critical-section = "1.2.0"
log = "0.4.27"
esp-hal = { version = "~1.2.2", features = [
    "{{ chip.name }}",
    {% if opt["unstable-hal"] %}
    "unstable",
    {% endif %}
    "log-04",
] }
{% if embassy or opt.wifi or opt["ble-trouble"] %}
esp-rtos = { version = "0.4.0", features = [
    {% if opt.wifi or opt["ble-trouble"] %}
    "esp-radio",
    {% endif %}
    {% if opt.alloc %}
    "esp-alloc",
    {% endif %}
    {% if embassy %}
    "embassy",
    {% endif %}
    "{{ chip.name }}",
    "log-04",
] }
{% endif %}
esp-bootloader-esp-idf = { version = "0.6.0", features = [
    "log-04",
    "{{ chip.name }}",
] }
esp-println = { version = "0.18.0", default-features = false, features = [
    "{{ chip.name }}",
    "{{ console }}",
    "log-04",
] }
esp-backtrace = { version = "0.20.0", features = [
    "{{ chip.name }}",
    "panic-handler",
    "println",
] }
{% if opt.alloc %}
esp-alloc = { version = "0.11.0", features = ["{{ chip.name }}"] }
{% endif %}
{% if opt.wifi or opt["ble-trouble"] %}
embedded-io = "0.7.1"
{% if embassy %}
embedded-io-async = "0.7.0"
{% if opt.wifi %}
embassy-net = { version = "0.9.1", features = [
    "tcp",
    "udp",
    "dhcpv4",
    "medium-ethernet",
    "log",
] }
# for more networking protocol support see https://crates.io/crates/edge-net
{% endif %}
{% endif %}
{% if opt.wifi %}
smoltcp = { version = "0.14.0", default-features = false, features = [
    "medium-ethernet",
    "multicast",
    "proto-dhcpv4",
    "proto-dns",
    "proto-ipv4",
    "socket-dns",
    "socket-raw",
    "socket-tcp",
    "socket-udp",
    "socket-icmp",
    "log",
] }
{% endif %}
esp-radio = { version = "1.0.0-beta.1", features = [
    "{{ chip.name }}",
    {% if opt.wifi %}
    "wifi",
    {% endif %}
    {% if opt["ble-trouble"] %}
    "ble",
    {% endif %}
    {% if opt.wifi and opt["ble-trouble"] %}
    "coex",
    {% endif %}
    {% if opt.alloc %}
    "esp-alloc",
    {% endif %}
    "unstable",
    "log-04",
] }
{% if opt["ble-trouble"] %}
trouble-host = { version = "0.7.0", features = ["gatt"] }
bt-hci = "0.9.0"
{% endif %}
{% endif %}
{% if embassy %}
embassy-executor = { version = "0.10.0", features = ["log"] }
embassy-time = { version = "0.5.0", features = ["log"] }
{% endif %}

# For fine tuning these settings, please refer to https://doc.rust-lang.org/cargo/reference/profiles.html
[profile.dev]
# The default debug profile is too slow and too big for resource-constrained devices.
# Always build with some optimizations enabled.
opt-level = "s"

[profile.release]
codegen-units = 1       # LLVM can perform better optimizations using a single thread
debug = 2               # prefer slower builds but better debugging experience
lto = 'fat'
opt-level = 's'
