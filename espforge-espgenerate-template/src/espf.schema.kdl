// The schema (KDL v2): the single source of truth for what an ESPF file may
// contain, and for the build options it can turn on.
//
// Two documents live in one file — `section`/`element` nodes (the ESPF
// vocabulary) and `required`/`options` nodes (the build options). Each reader
// skips the other's nodes, so there is one file to keep true and no second
// schema to drift from it.
//
// Consumers:
//   * `espforge-options::catalog` loads the element half for `espforge espf`
//     (man pages, examples, completions data).
//   * `espforge-options::schema` loads the option half for the resolver.
//   * `espforge-bindings` reads the element half at build time and generates
//     `src/components/generated_vocab.rs` (the tags `resolve_component`
//     dispatches: the elements marked `bus_component=#true` below) and
//     `src/components/generated_elements.rs` (one typed `Attrs` struct per
//     element: `required`, `kind`, `choices`, `range` and `default` are read
//     from here, never restated in a wrapper). Nothing else may declare that
//     list by hand.
//
// `<led>` and `<button>` are components too — an element is a component when
// it lives in the `components` section — but they have their own typed
// wrappers and are not bus dispatchers, so they carry no `bus_component`.
//
//   section "name" { summary ...; description ... }
//   element "tag" section="name" [status="planned"] [bus_component=#false] {
//       summary, description, attr, example, see_also, compatible
//   }
//   attr "name" kind="ident|str|pin|freq|hex|u32|bool|choice|ref|pin_or_ref|list"
//       [required=#true] [default=".."] [range="low..=high"] [to="tag"] [of="str"]
//       { choices "a" "b"; help ".." }
//
// `pin_or_ref` is a chip-select: a GPIO number (`cs="9"`) or a <gpio> id
// (`cs="gpio5"`, `cs="$gpio5"`), resolved by the element that uses it.
//
// Every element needs at least one `example`. Examples are parsed by the
// tests, so they cannot drift from the attributes declared here.
// Example fragments are raw strings (#"..."#) so they can contain quotes.
//
// SCAFFOLD: summaries and examples are first drafts; descriptions and
// per-attribute help are the blanks to fill in. Attributes follow what the
// code does today (espforge-bindings components, espf context.rs);
// places where the code and the embedded examples disagree are marked
// TODO(11.11) after the open question in plan.md.

// ---------------------------------------------------------------- espforge

section "espforge" {
    summary "The project itself: name, chip, runtime, console, options"
    description "Settings for the build as a whole. Nothing here is referred to from other sections, so these elements need no id."
}

element "project" section="espforge" {
    summary "Project name and description"
    attr "name" kind="str" required=#true {
        help "Becomes the crate name: lowercased, other characters become _."
    }
    attr "description" kind="str"
    example "minimal" #"<project name="blink" />"#
}

element "chip" section="espforge" {
    summary "The ESP32 chip to build for"
    // TODO: the list of chips is generated from esp-metadata, not written here.
    attr "type" kind="str" required=#true
    example "esp32c3" #"<chip type="esp32c3" />"#
}

element "runtime" section="espforge" {
    summary "blocking or embassy (async) runtime"
    attr "type" kind="choice" required=#true {
        choices "blocking" "embassy"
    }
    example "async" #"<runtime type="embassy" />"#
}

element "console" section="espforge" {
    summary "Where log output goes: uart or the built-in USB serial"
    attr "type" kind="choice" default="uart" {
        choices "uart" "jtag-serial"
        help "jtag-serial needs a chip with USB-Serial-JTAG."
    }
    example "usb serial" #"<console type="jtag-serial" />"#
}

element "options" section="espforge" {
    summary "Build options from the schema's options block"
    // TODO: the other option names come from the `options` block at the end of
    // this file.
    attr "defaults" kind="bool" default="true" {
        help "false turns every unspecified option off."
    }
    example "defaults only" #"<options defaults="true" />"#
}

// -------------------------------------------------------------- peripherals

section "peripherals" {
    summary "The chip's hardware blocks you use: gpio, i2c, spi, uart"
    description "The chip's hardware blocks that your project uses. Each one gets an id that components refer to with $id."
}

element "gpio" section="peripherals" {
    summary "A single GPIO pin"
    attr "id" kind="ident" required=#true
    attr "pin" kind="pin" required=#true
    // TODO(11.11): `direction` is on <gpio> in the blink and button examples
    // but on <gpio_component> in the wrapper and in examples/example.espf.txt.
    attr "direction" kind="choice" {
        choices "output" "input"
    }
    example "minimal" #"<gpio id="gpio4" pin="4" />"#
    see_also "components/gpio_component"
}

element "i2c" section="peripherals" {
    summary "I2C bus controller"
    description #"Declares an I2C controller. Reference it from a component with i2c="$id"."#
    attr "id" kind="ident" required=#true
    attr "sda" kind="pin" required=#true {
        help "GPIO number; must be valid for the chosen chip."
    }
    attr "scl" kind="pin" required=#true
    attr "frequency" kind="freq" default="100kHz"
    example "minimal" #"<i2c id="i2c0" sda="6" scl="7" />"#
    example "with a bus speed" #"<i2c id="i2c0" sda="6" scl="7" frequency="400kHz" />"#
    example "with a component" #"""
        # peripherals
          <i2c id="i2c0" sda="6" scl="7" />
        # components
          <i2c_component id="temp_bus" i2c="$i2c0" address="0x48" />
        """#
    see_also "components/i2c_component"
}

element "spi" section="peripherals" {
    summary "SPI bus controller"
    attr "id" kind="ident" required=#true
    attr "sclk" kind="pin" required=#true
    attr "mosi" kind="pin" required=#true
    attr "miso" kind="pin" {
        help "Displays generally omit it."
    }
    // Optional on both <spi> and <spi_component>; the wrapper defaults it to 0
    // and rejects anything outside 0..=3, which is what `range` records.
    attr "mode" kind="u32" default="0" range="0..=3"
    attr "frequency" kind="freq"
    example "write-only" #"<spi id="spi2" sclk="6" mosi="7" />"#
    see_also "components/spi_component"
}

element "uart" section="peripherals" {
    summary "UART port"
    attr "id" kind="ident" required=#true
    attr "uart" kind="str" {
        help "Physical peripheral, e.g. UART1. Optional: without it the id itself must be uart0, uart1, uart2 or uart3 and names the peripheral."
    }
    attr "tx" kind="pin" required=#true
    attr "rx" kind="pin" required=#true
    example "minimal" #"<uart id="uart1" tx="20" rx="21" />"#
    example "explicit peripheral" #"<uart id="gps" uart="UART1" tx="20" rx="21" />"#
    see_also "components/uart_component"
}

// --------------------------------------------------------------- components

section "components" {
    summary "How a peripheral is used: an address on a bus, a direction"
    description #"A component binds a peripheral to a purpose. It refers to its peripheral with $id, for example i2c="$i2c0"."#
}

element "led" section="components" bus_component=#false {
    summary "An LED on a GPIO output"
    description #"A component over <gpio>: gpio="$<gpio id>" must name an output pin."#
    attr "id" kind="ident" required=#true
    attr "gpio" kind="ref" to="gpio" required=#true
    attr "active_low" kind="bool" default="false" {
        help "true when the LED lights on a LOW pin."
    }
    example "minimal" #"<led id="red_led" gpio="$gpio18" />"#
    example "active low" #"<led id="status" gpio="$gpio18" active_low="true" />"#
    see_also "peripherals/gpio"
}

element "button" section="components" bus_component=#false {
    summary "A push button on a GPIO input"
    description #"A component over <gpio>: gpio="$<gpio id>" must name an input pin."#
    attr "id" kind="ident" required=#true
    attr "gpio" kind="ref" to="gpio" required=#true
    attr "pull_up" kind="bool" default="false" {
        help "true when the pin has an external pull-up (button to GND)."
    }
    example "minimal" #"<button id="btn" gpio="$gpio9" />"#
    example "pull-up" #"<button id="btn" gpio="$gpio9" pull_up="true" />"#
    see_also "peripherals/gpio"
}

element "gpio_component" section="components" bus_component=#true {
    summary "A GPIO pin used as an input or an output"
    attr "id" kind="ident" required=#true
    attr "gpio" kind="ref" to="gpio" required=#true
    attr "direction" kind="choice" required=#true {
        choices "output" "input"
    }
    example "output" #"<gpio_component id="blue_led" gpio="$gpio4" direction="output" />"#
    see_also "peripherals/gpio"
}

element "i2c_component" section="components" bus_component=#true {
    summary "A device address on an I2C bus"
    attr "id" kind="ident" required=#true
    attr "i2c" kind="ref" to="i2c" required=#true
    // Optional: a bus-level component (an I2C scanner) has no one address;
    // a driver that talks to a fixed part may still declare it.
    attr "address" kind="hex" {
        help "Omit for a bus-only component (for example an I2C scanner)."
    }
    example "temperature sensor" #"<i2c_component id="temp_bus" i2c="$i2c0" address="0x48" />"#
    see_also "peripherals/i2c"
}

element "spi_component" section="components" bus_component=#true {
    summary "A chip-select on an SPI bus"
    attr "id" kind="ident" required=#true
    attr "spi" kind="ref" to="spi" required=#true
    attr "mode" kind="u32" default="0" range="0..=3" {
        help "SPI mode, 0 to 3. Optional on the component; the SPI examples keep it on <spi>."
    }
    attr "cs" kind="pin_or_ref" required=#true {
        help "A GPIO number (`cs=\"9\"`), a <gpio> id (`cs=\"gpio5\"`) or a reference to one (`cs=\"$gpio5\"`)."
    }
    attr "frequency" kind="freq"
    example "display bus" #"<spi_component id="display_bus" spi="$spi2" mode="0" cs="gpio5" frequency="40MHz" />"#
    see_also "peripherals/spi"
}

element "uart_component" section="components" bus_component=#true {
    summary "Serial settings on a UART port"
    attr "id" kind="ident" required=#true
    attr "uart" kind="ref" to="uart" required=#true
    attr "baud_rate" kind="u32" required=#true
    attr "parity" kind="choice" default="none" {
        choices "none" "even" "odd"
    }
    attr "stop_bits" kind="choice" default="1" {
        choices "1" "2"
    }
    example "9600 baud" #"<uart_component id="serial_bus" uart="$uart1" baud_rate="9600" />"#
    see_also "peripherals/uart"
}

// ------------------------------------------------------------------ devices

section "devices" {
    summary "Drivers for specific parts: displays, sensors"
    description #"A device is a driver for a specific part. It refers to the component it is attached to, for example i2c_component="$temp_bus"."#
}

element "status_led" section="devices" {
    summary "An LED on a GPIO output"
    attr "id" kind="ident" required=#true
    attr "gpio_component" kind="ref" to="gpio_component" required=#true
    example "minimal" #"<status_led id="status" gpio_component="$blue_led" />"#
    see_also "components/gpio_component"
}

element "ili9341" section="devices" {
    summary "ILI9341 TFT display on SPI"
    attr "id" kind="ident" required=#true
    attr "spi_component" kind="ref" to="spi_component" required=#true
    // TODO: dc, rst and cs are optional here until the driver's needs are settled.
    attr "dc" kind="ref" to="gpio"
    attr "rst" kind="ref" to="gpio"
    attr "cs" kind="ref" to="gpio"
    example "with control pins" #"<ili9341 id="display" spi_component="$main_spi" dc="$pin_dc" rst="$pin_rst" cs="$pin_cs" />"#
    see_also "components/spi_component"
}

element "tmp102" section="devices" {
    summary "TMP102 temperature sensor on I2C"
    attr "id" kind="ident" required=#true
    attr "i2c_component" kind="ref" to="i2c_component" required=#true
    example "minimal" #"<tmp102 id="outdoor_temp" i2c_component="$temp_bus" />"#
    see_also "components/i2c_component"
}

// ----------------------------------------------------------------- services

section "services" {
    summary "Software services: wifi, ntp"
    description "Services are software, not hardware: nothing in them refers to a peripheral."
}

element "wifi" section="services" status="planned" {
    summary "Wi-Fi station connection"
    attr "id" kind="ident" required=#true
    // TODO(11.9): numbered groups (network1, network2, ...) as one pattern.
    attr "network1.ssid" kind="str" required=#true
    attr "network1.password" kind="str"
    example "one network" #"<wifi id="wifi0" network1.ssid="home" network1.password="pw" />"#
}

element "ntp" section="services" status="planned" {
    summary "Network time"
    attr "id" kind="ident" required=#true
    attr "servers" kind="list" of="str"
    example "two servers" #"<ntp id="ntp0" servers+="pool.ntp.org" servers+="time.google.com" />"#
}


// ------------------------------------------------------------------- options
//
// The build-option schema: what `<options ... />` and the `--option` flags can
// turn on. Read by `espforge-options::schema`; the element catalog ignores
// these nodes, and the generated `Attrs` for `<options>` covers only the
// `defaults` attribute above.

required "chip"

options {
    option "unstable-hal" display_name="Enable unstable HAL features." default=#true {
        help "This configuration enables unstable esp-hal features. These come with no stability guarantees, and could be changed or removed at any time."
    }

    option "alloc" display_name="Enable allocations via the esp-alloc crate." default=#true {
        help "esp-alloc comes with no stability guarantees at this time."
    }

    option "wifi" display_name="Enable Wi-Fi via the esp-radio crate." {
        help "esp-radio comes with no stability guarantees at this time."
        requires "alloc" "unstable-hal" "embassy"
        compatible {
            chip "esp32" "esp32c2" "esp32c3" "esp32c5" "esp32c6" "esp32c61" "esp32s2" "esp32s3" "esp32s31"
        }
    }

    option "ble-trouble" display_name="Enable BLE via the esp-radio crate (embassy-trouble)." {
        help "esp-radio comes with no stability guarantees at this time."
        requires "alloc" "unstable-hal" "embassy"
        compatible {
            chip "esp32" "esp32c2" "esp32c3" "esp32c5" "esp32c6" "esp32c61" "esp32h2" "esp32s3"
        }
    }

    option "embassy" display_name="Add embassy framework support." selection_group="base-template" {
        help "esp-rtos module responsible for embassy support comes with no stability guarantees at this time."
        requires "unstable-hal"
    }

    option "stack-smashing-protection" display_name="Enable stack smashing protection." requires_nightly=#true {
        help "Requires nightly Rust. Note that this option generates additional checks in most functions and will slow down your code."
    }

    option "probe-rs" display_name="Use probe-rs to flash and monitor instead of espflash." {
        requires_tools "probe-rs"
        help "probe-rs is a debugger that connects"
    }

    // Emit the Wokwi simulation files (diagram.json, wokwi.toml).
    option "wokwi" display_name="Generate Wokwi simulation files." default=#true {
        help "Writes diagram.json and wokwi.toml so the project can be simulated in Wokwi."
    }

    // Examples with a custom Wokwi chip ship its Zig sources next to the
    // prebuilt chip.json / chip.wasm (which are always copied).
    option "keep-zig-source" display_name="Keep the Zig source of custom Wokwi chips." {
        help "Copies the example's chip/ directory (Zig sources and build files) into the project. chip.json and chip.wasm are always copied."
    }
}
