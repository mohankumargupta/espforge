// The `# devices` half of the schema, co-located with the drivers it describes.
//
// `espforge-schema`'s `load_all` composes this file with `espf.schema.kdl`, so
// adding a driver touches this crate only: the feature in `Cargo.toml`, the
// module and re-export in `src/lib.rs`, and the element here.
//
// A `device_recipe` is data, not code:
//
//   bus "<kind>"       the bus kind the device binds to: `i2c`, `spi` or
//                       `uart`. The element's `bus="$<peripheral id>"`
//                       reference must name a peripheral of that kind.
//   feature "<name>"    the `espforge-drivers` feature the project names
//   kind "<word>"       the word the bus-mode diagnostic uses
//   runtime "blocking"  a bus mode the driver supports: `blocking`, `async`,
//                       or both (one `runtime` line each). A bus's mode is
//                       resolved from the drivers bound to it; a bus with a
//                       blocking-only and an async-only driver is refused.
//   type "<path>"       the generated field's type, with `{slot}` per argument
//   new "<path>"        the constructor, called with the bus and every `arg`
//   needs_address       the device declares its own `address` attribute
//   needs_address "0x62"    the part's fixed address: any other value is a
//                       wiring error
//   deps "<crate>"      a crate the generated project must name
//   arg "<attr>" {      a `map` slot: every value the attribute allows to the
//       map ".." ".."   Rust expression it emits
//   }
//   arg "<attr>" pin="<expr with {n}>"   a claimed control line: the `<gpio>`
//       direction="output"               reference is resolved, checked and
//                                        claimed, and the pin number fills `{n}`
//
// The lowerer that reads this lives in `espforge-elements` and knows no tag.

// ------------------------------------------------------------------ displays

element "ssd1306" section="devices" {
    summary "SSD1306 monochrome OLED display (0.96\" / 1.3\")"
    description "Drives an I2C SSD1306 OLED panel in buffered graphics mode. Declares both bus modes: a blocking project gets `Ssd1306Display`, an embassy project the async type."
    device_recipe {
        bus "i2c"
        feature "ssd1306"
        runtime "blocking"
        runtime "async" {
            feature "ssd1306-async"
            type "espforge_drivers::AsyncSsd1306Display<{size}>"
            new "espforge_drivers::AsyncSsd1306Display::new"
            endpoint "espforge_drivers::AsyncI2cEndpoint"
        }
        kind "display"
        type "espforge_drivers::Ssd1306Display<{size}>"
        new "espforge_drivers::Ssd1306Display::new"
        endpoint "espforge_drivers::I2cEndpoint"
        // Any panel address: 0x3C and 0x3D are both common on this part.
        needs_address
        deps "embedded-graphics"
        arg "size" {
            map "128x64" "espforge_drivers::Oled128x64"
            map "128x32" "espforge_drivers::Oled128x32"
        }
        arg "rotation" {
            map "0" "espforge_drivers::DisplayRotation::Rotate0"
            map "90" "espforge_drivers::DisplayRotation::Rotate90"
            map "180" "espforge_drivers::DisplayRotation::Rotate180"
            map "270" "espforge_drivers::DisplayRotation::Rotate270"
        }
    }
    attr "id" kind="ident" required=#true
    attr "bus" kind="ref" to="i2c" required=#true {
        help "The <i2c> peripheral this display is wired to."
    }
    attr "address" kind="hex" required=#true {
        help "7-bit slave address, for example 0x3C."
    }
    attr "size" kind="choice" default="128x64" {
        choices "128x64" "128x32"
        help "Pixel dimensions of the OLED panel."
    }
    attr "rotation" kind="choice" default="0" {
        choices "0" "90" "180" "270"
        help "Display rotation in degrees clockwise."
    }
    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "boot builds the panel before setup; deferred builds it when the app calls init()."
    }
    example "minimal" #"<ssd1306 id="oled" bus="$i2c0" address="0x3C" />"#
    example "custom size and rotation" #"<ssd1306 id="oled" bus="$i2c0" address="0x3C" size="128x32" rotation="180" />"#
    see_also "peripherals/i2c"
}

element "ili9341" section="devices" {
    summary "ILI9341 240x320 RGB565 color TFT LCD display"
    description "Drives an SPI ILI9341 TFT display with its data/command, reset and optional backlight pins. Its own mode and frequency are applied before each transaction, so it can share a controller with a slower part."
    device_recipe {
        bus "spi"
        feature "ili9341"
        runtime "blocking"
        spi_config
        kind "display"
        type "espforge_drivers::Ili9341Display"
        new "espforge_drivers::Ili9341Display::new"
        endpoint "espforge_drivers::SpiEndpoint"
        deps "embedded-graphics"
        arg "dc" pin="esp_hal::gpio::Output::new(unsafe { registry.peripherals.GPIO{n}.clone_unchecked() }, esp_hal::gpio::Level::Low, esp_hal::gpio::OutputConfig::default())" direction="output"
        arg "reset" pin="esp_hal::gpio::Output::new(unsafe { registry.peripherals.GPIO{n}.clone_unchecked() }, esp_hal::gpio::Level::High, esp_hal::gpio::OutputConfig::default())" direction="output"
        arg "backlight" pin="esp_hal::gpio::Output::new(unsafe { registry.peripherals.GPIO{n}.clone_unchecked() }, esp_hal::gpio::Level::High, esp_hal::gpio::OutputConfig::default())" direction="output"
        arg "rotation" {
            map "0" "espforge_drivers::Orientation::Portrait"
            map "90" "espforge_drivers::Orientation::Landscape"
            map "180" "espforge_drivers::Orientation::PortraitFlipped"
            map "270" "espforge_drivers::Orientation::LandscapeFlipped"
        }
        arg "rgb" {
            map "false" "espforge_drivers::ColorOrder::Bgr"
            map "true" "espforge_drivers::ColorOrder::Rgb"
        }
    }
    attr "id" kind="ident" required=#true
    attr "bus" kind="ref" to="spi" required=#true {
        help "The <spi> peripheral providing SCLK and MOSI."
    }
    attr "cs" kind="pin_or_ref" required=#true {
        help "Chip-select GPIO number (`cs=\"9\"`) or a <gpio> reference."
    }
    attr "dc" kind="ref" to="gpio" required=#true {
        help "GPIO pin for Data/Command selection."
    }
    attr "reset" kind="ref" to="gpio" required=#true {
        help "GPIO pin for hardware reset (the driver pulses it during init)."
    }
    attr "backlight" kind="ref" to="gpio" {
        help "Optional GPIO pin to enable the display backlight (driven HIGH on init)."
    }
    attr "rotation" kind="choice" default="0" {
        choices "0" "90" "180" "270"
        help "Display orientation in degrees clockwise."
    }
    attr "rgb" kind="bool" default="false" {
        help "When true, uses RGB color order instead of BGR."
    }
    attr "mode" kind="choice" default="0" {
        choices "0" "1" "2" "3"
        help "SPI mode this panel needs, applied before every transaction."
    }
    attr "frequency" kind="freq" default="40000kHz" {
        help "SPI clock this panel accepts, applied before every transaction."
    }
    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "boot builds the panel before setup; deferred builds it when the app calls init()."
    }
    example "minimal" #"<ili9341 id="tft" bus="$spi2" cs="9" dc="$gpio4" reset="$gpio5" />"#
    example "with reset and backlight" #"<ili9341 id="tft" bus="$spi2" cs="9" dc="$gpio4" reset="$gpio5" backlight="$gpio6" rotation="90" />"#
    see_also "peripherals/spi"
    see_also "peripherals/gpio"
}

// ------------------------------------------------------------------- sensors

element "scd4x" section="devices" {
    summary "Sensirion SCD40/SCD41 CO2, temperature and humidity sensor"
    description "Takes environmental readings over an I2C bus. Blocking runtime only."
    device_recipe {
        bus "i2c"
        feature "scd4x"
        runtime "blocking"
        kind "sensor"
        type "espforge_drivers::Scd4x"
        new "espforge_drivers::Scd4x::new"
        endpoint "espforge_drivers::Scd4xI2cEndpoint"
        // The part answers at one address only.
        needs_address "0x62"
    }
    attr "id" kind="ident" required=#true
    attr "bus" kind="ref" to="i2c" required=#true {
        help "The <i2c> peripheral the sensor is wired to."
    }
    attr "address" kind="hex" required=#true {
        help "The sensor's fixed address, 0x62."
    }
    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "boot builds the sensor before setup; deferred builds it when the app calls init()."
    }
    example "minimal" #"<scd4x id="air" bus="$i2c0" address="0x62" />"#
    example "deferred" #"<scd4x id="air" bus="$i2c0" address="0x62" init="deferred" />"#
    see_also "peripherals/i2c"
}

element "adxl345" section="devices" {
    summary "Analog Devices ADXL345 three-axis accelerometer"
    description "Reads three axes over SPI. Its own mode 3 and 5MHz (5000kHz) clock are applied before each transaction, so it shares a controller with a display running a different configuration."
    device_recipe {
        bus "spi"
        feature "adxl345"
        runtime "blocking"
        runtime "async" {
            feature "adxl345-async"
            type "espforge_drivers::AsyncAdxl345"
            new "espforge_drivers::AsyncAdxl345::new"
            endpoint "espforge_drivers::AsyncAdxl345Endpoint"
        }
        spi_config
        kind "sensor"
        type "espforge_drivers::Adxl345"
        new "espforge_drivers::Adxl345::new"
        endpoint "espforge_drivers::Adxl345Endpoint"
    }
    attr "id" kind="ident" required=#true
    attr "bus" kind="ref" to="spi" required=#true {
        help "The <spi> peripheral sharing SCLK, MOSI and MISO."
    }
    attr "cs" kind="pin_or_ref" required=#true {
        help "Chip-select GPIO number (`cs=\"10\"`) or a <gpio> reference."
    }
    attr "mode" kind="choice" default="3" {
        choices "0" "1" "2" "3"
        help "SPI mode the part needs (mode 3)."
    }
    attr "frequency" kind="freq" default="5000kHz" {
        help "SPI clock the part accepts, up to 5MHz."
    }
    attr "init" kind="choice" default="boot" {
        choices "boot" "deferred"
        help "boot builds the sensor before setup; deferred builds it when the app calls init()."
    }
    example "minimal" #"<adxl345 id="accel" bus="$spi2" cs="10" />"#
    example "slow clock" #"<adxl345 id="accel" bus="$spi2" cs="10" frequency="1000kHz" />"#
    see_also "peripherals/spi"
}
